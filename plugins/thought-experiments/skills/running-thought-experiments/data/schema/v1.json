{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ryo-morimoto/plugins/thought-experiments/te/event.v1.json",
 "title": "te event, version 1",
 "type": "object",
 "required": [
  "kind"
 ],
 "properties": {
  "kind": {
   "enum": [
    "frame",
    "prior_answer",
    "holder",
    "prediction",
    "rival",
    "probe",
    "operation",
    "attack",
    "conclusion",
    "review",
    "correction",
    "supersede",
    "decision",
    "branch",
    "close"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "frame"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/frame"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "prior_answer"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/prior_answer"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "holder"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/holder"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "prediction"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/prediction"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "rival"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/rival"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "probe"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/probe"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "operation"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/operation"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "attack"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/attack"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "conclusion"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/conclusion"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "review"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/review"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "correction"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/correction"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "supersede"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/supersede"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "decision"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/decision"
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "branch"
     }
    }
   },
   "then": {
    "$ref": "#/$defs/branch"
   }
