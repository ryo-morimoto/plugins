     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     }
    },
    "strawman": {
     "type": "boolean"
    },
    "strongest_held": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false
  },
  "prediction": {
   "type": "object",
   "required": [
    "id",
    "v",
    "at",
    "kind",
